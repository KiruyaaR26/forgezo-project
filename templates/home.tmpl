{{template "base/head" .}}

<style>
/* Reset & Variables - Yuros Guideline */
:root {
  --spring-easing: cubic-bezier(0.32, 0.72, 0, 1);
  --yuros-bg: #0C1016;
  --yuros-text: #F8F8FF;
  --yuros-accent: #FF4500;
  --yuros-border: #2D3444;
  --glass-bg: rgba(248, 248, 255, 0.02);
  --glass-border: var(--yuros-border);
}

.page-content.home {
  padding-bottom: 6rem;
  position: relative;
  z-index: 1;
  background-color: var(--yuros-bg) !important;
  color: var(--yuros-text) !important;
}

.mesh-bg {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  overflow: hidden; z-index: -1;
  background-image: 
    radial-gradient(at 0% 0%, rgba(255, 69, 0, 0.08) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(255, 69, 0, 0.04) 0px, transparent 50%);
}
.noise-overlay {
  position: fixed; inset: 0; z-index: 50; pointer-events: none; opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}

.premium-hero {
  padding: 8rem 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-height: 85vh;
}
.hero-eyebrow {
  border-radius: 999px;
  padding: 0.375rem 1rem;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  font-weight: 600;
  margin: 0 auto 2rem auto;
  border: 1px solid var(--yuros-border);
  background: var(--glass-bg);
  color: var(--yuros-accent);
  width: max-content;
}
.hero-title {
  font-size: clamp(3rem, 10vw, 8rem);
  font-weight: 800;
  letter-spacing: -0.05em;
  line-height: 0.95;
  margin-bottom: 2rem;
  color: var(--yuros-text);
}
.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  font-weight: 500;
  opacity: 0.7;
  max-width: 42rem;
  margin: 0 auto;
  line-height: 1.6;
  color: var(--yuros-text);
}

.cta-wrapper {
  margin-top: 4rem;
  display: flex;
  justify-content: center;
}
.island-btn {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  border-radius: 999px;
  background: var(--yuros-accent);
  color: #ffffff;
  padding: 0.5rem 0.5rem 0.5rem 2rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 700ms var(--spring-easing);
  border: 1px solid rgba(255,255,255,0.1);
}
.island-btn:hover {
  transform: scale(0.98);
  box-shadow: 0 20px 40px rgba(255, 69, 0, 0.25);
}
.island-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 700ms var(--spring-easing);
  color: #ffffff;
}
.island-btn:hover .island-icon {
  transform: translate(4px, -1px) scale(1.1);
}

.bento-container {
  padding: 0 1rem;
  max-width: 1400px;
  margin: 0 auto;
}
.bento-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}
@media (min-width: 768px) {
  .bento-grid { grid-template-columns: repeat(12, 1fr); gap: 2rem; }
  .col-8 { grid-column: span 8; }
  .col-4 { grid-column: span 4; }
}

.bezel-outer {
  padding: 0.5rem;
  border-radius: 2.5rem;
  background: var(--glass-bg);
  border: 1px solid var(--yuros-border);
  height: 100%;
}
.bezel-inner {
  background: var(--yuros-bg);
  border-radius: 2rem;
  padding: 2rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: inset 0 1px 1px rgba(248, 248, 255, 0.05);
  transition: transform 700ms var(--spring-easing);
  overflow: hidden;
  position: relative;
  color: var(--yuros-text);
}
.bezel-inner.inverse {
  background: var(--yuros-accent);
  color: #ffffff;
  box-shadow: inset 0 1px 1px rgba(255,255,255,0.2);
}
@media (min-width: 768px) {
  .bezel-inner { padding: 3rem; }
  .flex-row-end { flex-direction: row; align-items: flex-end; }
}
.bezel-inner:hover {
  transform: scale(0.98);
}

.card-icon {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 999px;
  background: var(--glass-bg);
  border: 1px solid var(--yuros-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rem;
  color: var(--yuros-accent);
}
.inverse .card-icon {
  background: rgba(255,255,255,0.15);
  border-color: rgba(255,255,255,0.1);
  color: #ffffff;
}

.card-title {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 1rem;
  line-height: 1.2;
}
.card-desc {
  font-size: 1.125rem;
  opacity: 0.7;
  line-height: 1.6;
  max-width: 28rem;
}

.reveal-fade-up {
  animation: fadeUpReveal 1.2s var(--spring-easing) both;
}
.delay-100 { animation-delay: 100ms; }
.delay-200 { animation-delay: 200ms; }
.delay-300 { animation-delay: 300ms; }

@keyframes fadeUpReveal {
  0% { opacity: 0; filter: blur(12px); transform: translateY(4rem); }
  100% { opacity: 1; filter: blur(0); transform: translateY(0); }
}
</style>

<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home">
    <div class="noise-overlay"></div>
    <div class="mesh-bg"></div>

    <div class="premium-hero">
        <div class="reveal-fade-up">
            <div class="hero-eyebrow">
                Infrastruktur Inti
            </div>
        </div>

        <div class="reveal-fade-up delay-100">
            <h1 class="hero-title">
                Blackbird<br>Forge.
            </h1>
            <h2 class="hero-subtitle">
                Lingkungan Git level-industrial. Dirancang untuk kecepatan mutlak dan diamankan untuk tim Blackbird OS.
            </h2>

            {{if not .IsSigned}}
            <div class="cta-wrapper">
                <a class="island-btn" href="{{AppSubUrl}}/user/login">
                    <span style="font-size:1.125rem">Inisiasi Sesi</span>
                    <div class="island-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    </div>
                </a>
            </div>
            {{end}}
        </div>
    </div>

    {{template "home_forgejo" .}}

</div>

{{template "base/footer" .}}
