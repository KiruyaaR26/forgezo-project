							￼{{if eq .ObjectFormatName "sha256"}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>
							{{end}}
						</div>
					</div>
					</div>
				{{end}}

				<!-- Footer: Stats & Updated -->
				<div class="yuros-card-footer">
					<div class="yuros-card-stats muted-links">
						<!-- Language -->
						{{if .PrimaryLanguage}}
							<a class="yuros-stat-item" href="?q={{$.Keyword}}&sort={{$.SortType}}&language={{.PrimaryLanguage.Language}}{{if $.TabName}}&tab={{$.TabName}}{{end}}">
								<i class="yuros-lang-dot" style="background-color: {{.PrimaryLanguage.Color}}; color: {{.PrimaryLanguage.Color}};"></i>
								<span>{{.PrimaryLanguage.Language}}</span>
							</a>
						{{end}}
						
						<!-- Stars -->
						{{if not $.DisableStars}}
							<a class="yuros-stat-item" href="{{.Link}}/stars"
								aria-label="{{ctx.Locale.TrPluralString .NumStars "stars.n_stars" (printf "%d" .NumStars)}}"
								{{if ge .NumStars 1000}}
									data-tooltip-content="{{ctx.Locale.TrPluralString .NumStars "stars.n_stars" (ctx.Locale.PrettyNumber .NumStars)}}"
								{{end}}
								>
								{{svg "octicon-star" 14}}
								<span>{{CountFmt .NumStars}}</span>
							</a>
						{{end}}
						
						<!-- Forks -->
						{{if not $.DisableForks}}
							<a class="yuros-stat-item" href="{{.Link}}/forks"
								aria-label="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (printf "%d" .NumForks)}}"
								{{if ge .NumForks 1000}}
									data-tooltip-content="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (ctx.Locale.PrettyNumber .NumForks)}}"
								{{end}}
			<div class="yuros-repo-grid">
