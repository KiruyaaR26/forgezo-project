<div class="yuros-repo-grid">
	{{range .Repos}}
		<div class="yuros-card-outer yuros-fade-up">
			<div class="yuros-card-inner">
				
				<!-- Header: Icon & Title -->
				<div class="yuros-card-header">
					<div class="yuros-card-avatar">
						{{template "repo/icon" .}}
					</div>
					<div class="yuros-card-title-group">
						<div class="yuros-card-title">
							{{if and (or $.PageIsExplore $.PageIsProfileStarList) .Owner}}
								<a href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a> /
							{{end}}
							<a href="{{.Link}}">{{.Name}}</a>
						</div>
						
						<!-- Badges (Archived, Private, etc) -->
						<div class="yuros-card-badges">
							{{if .IsArchived}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.archived"}}</span>
							{{end}}
							{{if .IsPrivate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.private"}}</span>
							{{else}}
								{{if .Owner.Visibility.IsPrivate}}
									<span class="ui label">{{ctx.Locale.Tr "repo.desc.internal"}}</span>
								{{end}}
							{{end}}
							{{if .IsTemplate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.template"}}</span>
							{{end}}
							{{if eq .ObjectFormatName "sha256"}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>
							{{end}}
						</div>
					</div>
				</div>

				<!-- Body: Description HTML -->
				{{$description := .DescriptionHTML $.Context}}
				<div class="yuros-card-body">
					{{if $description}}
						{{$description}}
					{{else}}
						<span style="opacity: 0.4; font-style: italic;">No description provided.</span>
					{{end}}
				</div>

				<!-- Topics -->
				{{if .Topics}}
					<div class="yuros-card-topics repo-topics">
					{{range .Topics}}
						{{if ne . ""}}<a class="ui label" href="{{AppSubUrl}}/explore/repos?q={{.}}&topic=1">{{.}}</a>{{end}}
					{{end}}
			<div class="yuros-repo-grid">
	￼{{range .Repos}}
		￼<div class="yuros-card-outer yuros-fade-up">
			￼<div class="yuros-card-inner">
				
				<!-- Header: Icon & Title -->
