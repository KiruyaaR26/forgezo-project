							{{end}}
							￼{{if .IsTemplate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.template"}}</span>
							{{end}}
							￼{{if eq .ObjectFormatName "sha256"}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>
							{{end}}
						</div>
					</div>
								>
								{{svg "octicon-repo-forked" 14}}
								<span>{{CountFmt .NumForks}}</span>
							</a>
						{{end}}
					</div>
					
					<!-- Updated -->
					<div class="yuros-card-updated">
						{{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .UpdatedUnix)}}
					</div>
				</div>

			</div>
		</div>
	{{else}}
		<!-- Empty State -->
		<div class="yuros-no-results">
			{{ctx.Locale.Tr "search.no_results"}}
		</div>
	{{end}}
</div>
