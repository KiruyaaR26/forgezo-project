    {{template "base/head" .}}                                                                                                                                                           
    <div role="main" aria-label="{{.Title}}" class="page-content repository new repo yuros-newrepo-wrapper">                                                                             
        <div class="yuros-newrepo-container yuros-newrepo-fade-up">                                                                                                                         
            <div class="yuros-newrepo-page-header">                                                                                                                                             
                <h1 class="yuros-newrepo-title">{{ctx.Locale.Tr "new_repo.title"}}</h1>                                                                                                             
                <p class="yuros-newrepo-subtitle">Inisialisasi repositori berkeamanan tinggi baru di namespace kamu.</p>                                                                            
            </div>                                                                                                                                                                              
                                                                                                                                                                                                
            <form class="ui form yuros-newrepo-form" action="{{.Link}}" method="post">                                                                                                          
                {{if or .CanCreateRepo .Orgs}}                                                                                                                                                      
                    {{template "base/alert" .}}                                                                                                                                                         
                    {{template "repo/create_helper" .}}                                                                                                                                                 
                                                                                                                                                                                         
                    {{if and (not .CanCreateRepo) (ne .MaxCreationLimit 0)}}                                                                                                                            
                        <div class="yuros-newrepo-alert-error">                                                                                                                                             
                            <p>{{ctx.Locale.TrN .MaxCreationLimit "repo.form.reach_limit_of_creation_1" "repo.form.reach_limit_of_creation_n" .MaxCreationLimit}}</p>                                           
                        </div>                                                                                                                                                                              
                    {{end}}                                                                                                                                                                             
                                                                                                                                                                                         
                    <!-- BASIC SECTION -->                                                                                                                                                              
                    <div class="yuros-newrepo-section-outer">                                                                                                                                           
                        <div class="yuros-newrepo-section-inner">                                                                                                                                           
                            {{template "repo/create_basic" .}}                                                                                                                                                  
                        </div>                                                                                                                                                                              
                    </div>                                                                                                                                                                              
                                                                                                                                                                                         
                    <!-- TEMPLATE SECTION -->                                                                                                                                                           
                    <div class="yuros-newrepo-section-outer">                                                                                                                                           
                        <div class="yuros-newrepo-section-inner">                                                                                                                                           
                            <div class="yuros-newrepo-section-header">                                                                                                                                          
                                <h3>{{ctx.Locale.Tr "repo.new_from_template"}}</h3>                                                                                                                                 
                                <span>{{ctx.Locale.Tr "repo.new_from_template_description"}}</span>                                                                                                                 
                            </div>                                                                                                                                                                              
                            {{template "repo/create_from_template" .}}                                                                                                                                          
                        </div>                                                                                                                                                                              
                    </div>                                                                                                                                                                              
                                                                                                                                                                                         
                    <div id="non_template">                                                                                                                                                             
                        <!-- INIT SECTION -->                                                                                                                                                               
                        <div class="yuros-newrepo-section-outer">                                                                                                                                           
                            <div class="yuros-newrepo-section-inner">                                                                                                                                           
                                {{template "repo/create_init" .}}                                                                                                                                                   
                            </div>                                                                                                                                                                              
                        </div>                                                                                                                                                                              
                                                                                                                                                                                         
                        <!-- ADVANCED SECTION -->                                                                                                                                                           
                        <div class="yuros-newrepo-section-outer">                                                                                                                                           
                            <div class="yuros-newrepo-section-inner yuros-newrepo-section-advanced">                                                                                                            
                                <details class="yuros-newrepo-details">                                                                                                                                             
                                    <summary class="yuros-newrepo-summary">                                                                                                                                             
                                        <div class="yuros-newrepo-summary-content">                                                                                                                                         
                                            <h3>{{ctx.Locale.Tr "repo.new_advanced"}}</h3>                                                                                                                                      
                                            <span>{{ctx.Locale.Tr "repo.new_advanced_expand"}}</span>                                                                                                                           
                                        </div>                                                                                                                                                                              
                                        <div class="yuros-newrepo-summary-icon">                                                                                                                                            
                                            {{svg "octicon-chevron-down" 16}}                                                                                                                                                   
                                        </div>                                                                                                                                                                              
                                    </summary>                                                                                                                                                                          
                                    <div class="yuros-newrepo-details-body">                                                                                                                                            
                                        {{template "repo/create_advanced" .}}                                                                                                                                               
                                    </div>                                                                                                                                                                              
                                </details>                                                                                                                                                                          
                            </div>                                                                                                                                                                              
                        </div>                                                                                                                                                                              
                    </div>                                                                                                                                                                              
                                                                                                                                                                                         
                    <!-- SUBMIT -->                                                                                                                                                                     
                    <div class="yuros-newrepo-actions">                                                                                                                                                 
                        <button class="yuros-newrepo-btn-primary">                                                                                                                                          
                            <span class="yuros-newrepo-btn-text">{{ctx.Locale.Tr "repo.create_repo"}}</span>                                                                                                    
                            <div class="yuros-newrepo-btn-icon">                                                                                                                                                
                                {{svg "octicon-arrow-right" 16}}                                                                                                                                                    
                            </div>                                                                                                                                                                              
                        </button>                                                                                                                                                                           
                    </div>                                                                                                                                                                              
                {{else}}                                                                                                                                                                            
                    <div class="yuros-newrepo-alert-error">                                                                                                                                             
                        {{ctx.Locale.Tr "repo.form.cannot_create"}}                                                                                                                                         
                    </div>                                                                                                                                                                              
                {{end}}                                                                                                                                                                             
            </form>                                                                                                                                                                             
        </div>                                                                                                                                                                              
    </div>                                                                                                                                                                               
    {{template "base/footer" .}}  
