    <div class="yuros-newrepo-field">                                                                                                                                                    
        <label>                                                                                                                                                                             
            {{ctx.Locale.Tr "repo.issue_labels"}}                                                                                                                                               
        </label>                                                                                                                                                                            
        <div class="ui search selection dropdown yuros-newrepo-dropdown">                                                                                                                   
            <input type="hidden" name="issue_labels" value="{{.issueLabels}}">                                                                                                                  
            <div class="default text">{{ctx.Locale.Tr "repo.issue_labels_helper"}}</div>                                                                                                        
            <div class="menu">                                                                                                                                                                  
                <div class="item" data-value="">{{ctx.Locale.Tr "repo.issue_labels_helper"}}</div>                                                                                                  
                {{range .LabelTemplateFiles}}                                                                                                                                                       
                    <div class="item" data-value="{{.DisplayName}}">{{.DisplayName}}<br><span class="yuros-newrepo-help">({{.Description}})</span></div>                                                
                {{end}}                                                                                                                                                                             
            </div>                                                                                                                                                                              
        </div>                                                                                                                                                                              
    </div>                                                                                                                                                                               
                                                                                                                                                                                         
    {{$supportedFormatsLength := len .SupportedObjectFormats}}                                                                                                                           
    {{if ge $supportedFormatsLength 2}}                                                                                                                                                  
        <div class="yuros-newrepo-field">                                                                                                                                                   
            <label>                                                                                                                                                                             
                {{ctx.Locale.Tr "repo.object_format"}}                                                                                                                                              
                <span class="yuros-newrepo-help">{{ctx.Locale.Tr "repo.object_format_helper"}}</span>                                                                                               
            </label>                                                                                                                                                                            
            <div class="ui selection dropdown yuros-newrepo-dropdown">                                                                                                                          
                <input type="hidden" id="object_format_name" name="object_format_name" value="{{.DefaultObjectFormat.Name}}" required>                                                              
                <div class="default text">{{.DefaultObjectFormat.Name}}</div>                                                                                                                       
                <div class="menu">                                                                                                                                                                  
                    {{range .SupportedObjectFormats}}                                                                                                                                                   
                        <div class="item" data-value="{{.Name}}">{{.Name}}</div>                                                                                                                            
                    {{end}}                                                                                                                                                                             
                </div>                                                                                                                                                                              
            </div>                                                                                                                                                                              
        </div>                                                                                                                                                                              
    {{else}}                                                                                                                                                                             
        <input type="hidden" name="object_format_name" value="{{.DefaultObjectFormat.Name}}" required>                                                                                      
    {{end}}                                                                                                                                                                              
                                                                                                                                                                                         
    <div class="yuros-newrepo-field">                                                                                                                                                    
        <label>                                                                                                                                                                             
            {{ctx.Locale.Tr "repo.default_branch"}}                                                                                                                                             
            <span class="yuros-newrepo-help">{{ctx.Locale.Tr "repo.default_branch_helper"}}</span>                                                                                              
        </label>                                                                                                                                                                            
        <input class="yuros-newrepo-input" name="default_branch" value="{{.default_branch}}" placeholder="{{.default_branch}}">                                                             
    </div>                                                                                                                                                                               
                                                                                                                                                                                         
    <div class="yuros-newrepo-field">                                                                                                                                                    
        <label class="yuros-newrepo-checkbox-label">                                                                                                                                        
            <div class="yuros-newrepo-checkbox-wrapper">                                                                                                                                        
                <input name="template" type="checkbox">                                                                                                                                             
                <div class="yuros-newrepo-checkbox-custom"></div>                                                                                                                                   
            </div>                                                                                                                                                                              
            <div class="yuros-newrepo-checkbox-content">                                                                                                                                        
                <span class="yuros-newrepo-checkbox-title">{{ctx.Locale.Tr "repo.template_helper"}}</span>                                                                                          
                <span class="yuros-newrepo-help">{{ctx.Locale.Tr "repo.template_description"}}</span>                                                                                               
            </div>                                                                                                                                                                              
        </label>                                                                                                                                                                            
    </div> 
